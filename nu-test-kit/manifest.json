{
  "manifest_version": 3,
  "name": "NU CRN Filler 测试工具",
  "version": "2.0.0",
  "description": "测试工具：检查 Banner 页面结构和提醒功能，并可在 Plan Ahead 中添加课程到计划。不会注册任何课程。",
  "permissions": ["activeTab", "notifications"],
  "host_permissions": ["https://nubanner.neu.edu/*"],
  "icons": { "48": "icon48.png", "128": "icon128.png" },
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "NU 测试工具" },
  "content_scripts": [
    {
      "matches": ["https://nubanner.neu.edu/StudentRegistrationSsb/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
