{
  "manifest_version": 3,
  "name": "NU Browse Classes Tester",
  "version": "1.2.0",
  "description": "Test version: runs the real search, paging, CRN and full-section logic on Browse Classes without adding or submitting anything.",
  "permissions": ["storage", "activeTab", "notifications"],
  "host_permissions": ["https://nubanner.neu.edu/*"],
  "icons": { "48": "icon48.png", "128": "icon128.png" },
  "background": { "service_worker": "background.js" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "NU Browse Classes Tester",
    "default_icon": { "48": "icon48.png", "128": "icon128.png" }
  },
  "content_scripts": [
    {
      "matches": ["https://nubanner.neu.edu/StudentRegistrationSsb/ssb/term/*", "https://nubanner.neu.edu/StudentRegistrationSsb/ssb/classSearch/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
