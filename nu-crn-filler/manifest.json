{
  "manifest_version": 3,
  "name": "NU CRN Filler",
  "version": "2.4.2",
  "description": "Finds your CRNs in Northeastern Banner search results, adds them, and can register you when your window opens.",
  "permissions": ["storage", "activeTab", "notifications"],
  "host_permissions": ["https://nubanner.neu.edu/*"],
  "icons": { "48": "icon48.png", "128": "icon128.png" },
  "background": { "service_worker": "background.js" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "NU CRN Filler",
    "default_icon": { "48": "icon48.png", "128": "icon128.png" }
  },
  "content_scripts": [
    {
      "matches": ["https://nubanner.neu.edu/StudentRegistrationSsb/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
